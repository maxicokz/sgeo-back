{
  "name": "ai-responses-collector",
  "version": "1.0.0",
  "description": "Multi-AI responses collector using OpenRouter and Supabase",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "collect": "node src/collect.js",
    "example": "node examples/basic-usage.js",
    "batch": "node examples/batch-collect.js",
    "setup": "cp .env.example .env && echo 'Created .env file. Please configure it with your credentials.'"
