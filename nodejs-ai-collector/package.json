    "gemini",
    "perplexity",
    "copilot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "franc": "^6.2.0",
    "uuid": "^9.0.1"
  }
}
