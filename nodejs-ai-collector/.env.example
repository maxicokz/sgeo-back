# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_API_URL=https://openrouter.ai/api/v1

# OpenAI Direct Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# AI Models Configuration
# ChatGPT 5.1
MODEL_CHATGPT=openai/gpt-5.1-chat
# DeepSeek V3
MODEL_DEEPSEEK=deepseek/deepseek-chat
# X.AI Grok-4-Fast
MODEL_GROK=x-ai/grok-4-fast
# Perplexity - Use Sonar Pro Search
MODEL_PERPLEXITY=perplexity/sonar-pro-search
# Gemini - Use Gemini 2.5 Flash (fast and cost-effective)
MODEL_GEMINI=google/gemini-2.5-flash

# Application Settings
APP_NAME=AI Responses Collector
LOG_LEVEL=info

# Web Server Settings
PORT=3000
