# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_API_URL=https://openrouter.ai/api/v1

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# AI Models Configuration
# ChatGPT
MODEL_CHATGPT=openai/gpt-4-turbo
# Bing (GPT-4)
MODEL_BING=openai/gpt-4-turbo
# Copilot (GPT-4)
MODEL_COPILOT=openai/gpt-4
# Perplexity - Use Sonar Pro Search
MODEL_PERPLEXITY=perplexity/sonar-pro-search
# Gemini - Use Gemini 2.5 Flash (fast and cost-effective)
MODEL_GEMINI=google/gemini-2.5-flash

# Application Settings
APP_NAME=AI Responses Collector
LOG_LEVEL=info

# Web Server Settings
PORT=3000
