# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sgeo_analytics
DB_USER=postgres
DB_PASSWORD=your_password

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_API_URL=https://openrouter.ai/api/v1

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_NAME="SGEO Analytics Dashboard"

# Session Configuration
SESSION_LIFETIME=7200
SESSION_SECURE=false

# Report Settings
REPORTS_PATH=./reports
TEMP_PATH=./temp

# LLM Models Configuration
MODEL_GPT4=openai/gpt-4-turbo-preview
MODEL_GPT35=openai/gpt-3.5-turbo
MODEL_CLAUDE=anthropic/claude-3-opus
MODEL_GEMINI=google/gemini-pro
MODEL_PERPLEXITY=perplexity/pplx-70b-online

# Monitoring Settings
MONITORING_ENABLED=true
LOG_LEVEL=info
